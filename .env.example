# Copie este arquivo para .env (opcional).
#
# A IA pode ser configurada de dois jeitos:
#   1. Na página, no painel "Configurar IA" (cada pessoa usa a própria chave, salva só no navegador).
#   2. Aqui, como padrão do servidor — usado quando a página não manda configuração.

# --- Opção A: assinatura do Claude (Pro/Max) pelo Claude Code ---
# Gere o token com:  docker compose run --rm adaptador claude setup-token
# (cole numa linha só, sem espaços — o terminal pode quebrar o token em duas linhas)
CLAUDE_CODE_OAUTH_TOKEN=
# Modelo opcional: sonnet, opus, haiku (vazio = padrão da assinatura)
# CLAUDE_CODE_MODELO=sonnet

# --- Opção B: qualquer API compatível com OpenAI ---
#   OpenAI      https://api.openai.com/v1
#   Claude      https://api.anthropic.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Ollama      http://host.docker.internal:11434/v1   (local, sem chave)
IA_BASE_URL=
IA_MODELO=
IA_API_KEY=
# IA_MAX_TOKENS=16000

# Se A e B estiverem preenchidas, o padrão é B. Para forçar: IA_TIPO=claude-code ou IA_TIPO=openai
# IA_TIPO=

# Opcional: senha para abrir a página (obrigatório se for expor em um servidor).
# Usuário: qualquer coisa. Senha: o valor abaixo.
# APP_PASSWORD=
