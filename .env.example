# Copie este arquivo para .env e preencha UMA das opções de autenticação.

# Opção 1 (recomendada): token da sua assinatura Claude (Pro/Max).
# Gere com:  docker compose run --rm adaptador claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Opção 2: chave da API da Anthropic (cobrança por uso).
# ANTHROPIC_API_KEY=

# Opcional: senha para abrir a página (obrigatório se for expor em um servidor).
# Usuário: qualquer coisa. Senha: o valor abaixo.
# APP_PASSWORD=
